# Senha mestra: acessa /admin, cria lojas e edita qualquer uma
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segredo usado para gerar o hash dos PINs dos lojistas (qualquer texto longo e aleatório)
ADMIN_SECRET=cole-aqui-um-texto-aleatorio-longo

# Seu WhatsApp (DDI+DDD+número). Pedidos feitos nas lojas de demonstração chegam para você.
DEMO_WHATSAPP=5577999999999

# Sua marca no rodapé das vitrines ("Quer uma vitrine assim?")
NEXT_PUBLIC_BRAND_NAME=Vitrine Zap
NEXT_PUBLIC_BRAND_WHATSAPP=5577999999999

# Criado automaticamente pela Vercel ao conectar um Blob Store ao projeto.
# Sem ele (em desenvolvimento), os JSON ficam em .data/stores/
# BLOB_READ_WRITE_TOKEN=
